# Copy to `.env.local` for local dev.
# On Vercel (Production), set the same keys — missing ones break trust emails.

## Required for local + production

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production: https://hansala.com

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key
# Or: NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service role — verification, claim tokens, partner/inquiry notify emails
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

## Email (required in production)

# Resend API key — without this, production trust emails fail loudly
RESEND_API_KEY=
# Must be a verified domain sender in production (not onboarding@resend.dev)
RESEND_FROM_EMAIL=Hansala <noreply@yourdomain.com>

## Optional

# Comma-separated staff emails allowed to access /admin (fail closed if unset)
# PLATFORM_ADMIN_EMAILS=you@hansala.com,ops@hansala.com

# AUTH_SITE_URL=https://www.hansala.com
# Shared session across www + apex (defaults to .hansala.com in prod):
# AUTH_COOKIE_DOMAIN=.hansala.com
# NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=.hansala.com
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_WEBHOOK_SECRET=

## Agent API / MCP (local Cursor — not Vercel)

# Create key in Workspace → API (Pro). Paste into .cursor/mcp.json env:
# HANSALA_AGENT_API_KEY=hs_...
# Optional override (defaults to https://www.hansala.com):
# HANSALA_API_BASE_URL=http://localhost:3000
# See .cursor/mcp.json.example and /developers#agent-mcp

## Scheduling (optional — Calendly / Cal.com on company profiles)

# Create OAuth apps and set redirect URIs exactly to:
#   https://www.hansala.com/api/integrations/calendly/callback
#   https://www.hansala.com/api/integrations/calcom/callback
# Local:
#   http://localhost:3000/api/integrations/calendly/callback
#   http://localhost:3000/api/integrations/calcom/callback
# (Optional second Cal.com URI if needed: https://hansala.com/api/integrations/calcom/callback)
# CALENDLY_CLIENT_ID=
# CALENDLY_CLIENT_SECRET=
# Cal.com is PKCE-only (no client secret):
# CALCOM_CLIENT_ID=
# CALCOM_CLIENT_SECRET=  # unused — leave unset
# Optional signed-state secret (falls back to service role / dev default):
# SCHEDULING_OAUTH_STATE_SECRET=

## Production checklist (Vercel + Supabase)

# 1. NEXT_PUBLIC_SITE_URL=https://www.hansala.com
# 2. Supabase Auth → Redirect URLs include both:
#    https://www.hansala.com/auth/callback
#    https://hansala.com/auth/callback
# 3. AUTH_COOKIE_DOMAIN=.hansala.com (www + apex share login)
# 4. SUPABASE_SERVICE_ROLE_KEY set (Project Settings → API)
# 5. RESEND_API_KEY + RESEND_FROM_EMAIL on a verified Resend domain
# 6. Vercel region fra1 (see vercel.json)
