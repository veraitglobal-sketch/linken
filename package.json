{
  "name": "linken",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "lint": "eslint src e2e --max-warnings 200",
    "format": "prettier --write \"tests/**/*.{mjs,ts}\" \"e2e/**/*.{ts,mjs}\" \"scripts/post-deploy-smoke.mjs\" \"scripts/check-*.mjs\"",
    "format:check": "prettier --check \"tests/**/*.{mjs,ts}\" \"e2e/**/*.{ts,mjs}\" \"scripts/post-deploy-smoke.mjs\"",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "node --test scripts/test-domain-allowed.mjs scripts/test-activation-derive.mjs scripts/test-plan-access.mjs scripts/test-dashboard-home.mjs scripts/test-seo-public.mjs scripts/test-product-analytics.mjs scripts/test-growth-loop.mjs scripts/test-a11y-static.mjs scripts/test-security.mjs scripts/test-hs-testimonials-seal.mjs tests/**/*.test.mjs",
    "test:email": "node --test tests/email/**/*.test.mjs",
    "test:api-contract": "node --test tests/api/**/*.test.mjs",
    "test:authz": "node --test tests/authz/**/*.test.mjs scripts/test-security.mjs",
    "test:journeys": "node --test tests/journeys/**/*.test.mjs",
    "test:migrations": "node --test tests/migrations/**/*.test.mjs",
    "test:resend": "node scripts/test-resend.mjs",
    "test:domain": "node --test scripts/test-domain-allowed.mjs",
    "test:activation": "node --test scripts/test-activation-derive.mjs",
    "test:plan": "node --test scripts/test-plan-access.mjs",
    "test:dashboard": "node --test scripts/test-dashboard-home.mjs",
    "test:seo": "node --test scripts/test-seo-public.mjs",
    "test:analytics": "node --test scripts/test-product-analytics.mjs",
    "test:growth": "node --test scripts/test-growth-loop.mjs",
    "test:a11y:static": "node --test scripts/test-a11y-static.mjs",
    "test:a11y": "playwright test --project=a11y",
    "test:smoke": "playwright test --project=smoke",
    "test:e2e": "playwright test",
    "test:security": "node --test scripts/test-security.mjs tests/authz/**/*.test.mjs",
    "test:ci": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run test:migrations && npm run build",
    "smoke:deploy": "node scripts/post-deploy-smoke.mjs",
    "prepublishOnly": "echo 'Do not publish the Hansala app. Publish only mcp/hansala-public.' && exit 1"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "@xyflow/react": "^12.11.2",
    "next": "16.2.10",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.2",
    "resend": "^6.17.2",
    "server-only": "^0.0.1",
    "stripe": "^17.7.0",
    "tldts": "^7.4.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "playwright": "^1.61.1",
    "prettier": "^3.9.6",
    "supabase": "^2.109.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "ws": "^8.21.1"
  }
}
